MONGODB_URI=mongodb://127.0.0.1:27017/aibox_dashboard

# Host AI Box mac dinh khi DB chua co cau hinh (doi trong Cai dat -> AI Box).
AIBOX_HOST=http://192.168.1.26

# MediaMTX (camera live + ghi hinh + tua lai). Xem docs/camera-management-dev.md.
# Server-side: control API va playback server (bind 127.0.0.1, Next proxy).
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
# Client-side (Next inline luc build): goc media trinh duyet goi truc tiep.
# Dev = localhost; production = origin cong khai cua MediaMTX.
NEXT_PUBLIC_MEDIA_HLS_BASE=http://127.0.0.1:8888
NEXT_PUBLIC_MEDIA_WEBRTC_BASE=http://127.0.0.1:8889
# Tai khoan doc luong media (authInternalUsers action:read cua MediaMTX).
# Server-side only - phat cho client qua /api/cameras/[code]/live (cookie-auth).
# Bo trong = MediaMTX khong bat auth (dev don gian).
MEDIA_VIEWER_USER=
MEDIA_VIEWER_PASS=
# Encoder transcode camera: libx264 (server Linux, mac dinh) hoac
# h264_videotoolbox (dev macOS - encode phan cung).
MEDIA_TRANSCODE_ENCODER=libx264
# Token gac endpoint cron dong bo path MediaMTX (POST /api/webhooks/cameras-sync).
# Bo trong = tat endpoint. Cron tren server goi kem header x-sync-token.
CAMERA_SYNC_TOKEN=
